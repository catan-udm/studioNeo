# ========================================================================
# Azure Database for MySQL Flexible Server Configuration
# ========================================================================
DB_HOST="code-web-azuredb.mysql.database.azure.com"
DB_PORT="3306"
DB_USER="studio_admin"
DB_PASSWORD="YourStrongPassword123!"
DB_NAME="experimental_studio_db"

# TLS/SSL Configuration for Azure MySQL Flexible Server
# Azure requires SSL by default. DigiCert Global Root CA is trusted in Node 18+.
DB_SSL_REJECT_UNAUTHORIZED="true"
# Optional: Absolute path to custom root CA if required (e.g., C:/certs/DigiCertGlobalRootCA.crt.pem)
DB_SSL_CA_PATH=""

# Pool sizing and timeout settings (TCP Keepalive guards against Azure firewall drops)
DB_CONNECTION_LIMIT="10"
DB_QUEUE_LIMIT="0"
DB_WAIT_FOR_CONNECTIONS="true"
DB_IDLE_TIMEOUT_MS="60000"
DB_KEEPALIVE_DELAY_MS="10000"

# ========================================================================
# Azure Blob Storage Configuration (Asset Management & SAS)
# ========================================================================
AZURE_STORAGE_ACCOUNT_NAME="bikkostudio"
# Primary or secondary access key from Azure Portal -> Storage Account -> Access keys
AZURE_STORAGE_ACCOUNT_KEY="dGVzdGFjY291bnRrZXlleGFtcGxlMTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI="
# Target private container for subscriber perk downloads
AZURE_STORAGE_CONTAINER_NAME="perk-assets"
# Optional: Alternative Full Connection String (leave empty if using account name + key)
AZURE_STORAGE_CONNECTION_STRING=""
# SAS Token Expiry duration in minutes (default 15 minutes)
AZURE_STORAGE_SAS_EXPIRY_MINUTES="15"

# ========================================================================
# Session & Cryptographic Authentication Configuration
# ========================================================================
# Minimum 32-character high-entropy secret for HMAC-SHA256 session token signatures
# (Generated via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SESSION_SECRET="a5ab42aee62d14fedab28308cbb0277b7f2a20c4cb59984fd8df71600b3a179c"
AUTH_SESSION_COOKIE_NAME="sanko_auth_session"
# Session lifespan in seconds (7 days = 604800)
AUTH_SESSION_TTL_SECONDS="604800"

# OTP Settings
AUTH_OTP_TTL_MINUTES="10"

# ========================================================================
# Azure Communication Services (Email Dispatch)
# ========================================================================
# Leave empty to log OTP codes directly to server console & dev UI quick-fill banner.
# For live emails: Azure Portal -> Communication Services -> Keys -> Primary connection string
AZURE_COMMUNICATION_CONNECTION_STRING=""
ACS_SENDER_EMAIL="DoNotReply@xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azurecomm.net"

# ========================================================================
# WebAuthn / Passkeys Configuration (FIDO2 Biometrics)
# ========================================================================
# Relying Party ID MUST be a domain name only, NEVER a URL with http/https or trailing slashes (e.g. 'localhost' or 'ashy-mushroom-07675a400.6.azurestaticapps.net')
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Azure Cloud Studio"

# ========================================================================
# Social OAuth 2.0 Providers (PKCE)
# ========================================================================
# Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs)
# Authorized redirect URI: http://localhost:3000/api/auth/oauth/google/callback or https://<your-domain>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID="123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-SampleSecretKey1234567890"

# Microsoft Entra ID / Microsoft Account (Azure Portal -> App Registrations -> Authentication)
# Authorized redirect URI: http://localhost:3000/api/auth/oauth/microsoft/callback or https://<your-domain>/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID="11111111-2222-3333-4444-555555555555"
MICROSOFT_CLIENT_SECRET="sample~MicrosoftClientSecretKey1234567890"
# Use 'common' for multi-tenant & personal Microsoft accounts, or specify your Azure Tenant ID
MICROSOFT_TENANT_ID="common"

# ========================================================================
# Application Runtime Configuration
# ========================================================================
NODE_ENV="development"
# Canonical public application URL without trailing slash
# (e.g. 'http://localhost:3000' or 'https://ashy-mushroom-07675a400.6.azurestaticapps.net')
# In Azure container environments, set APP_URL to prevent internal container ID resolution in OAuth.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
